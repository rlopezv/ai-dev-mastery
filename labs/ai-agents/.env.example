# AI Agents — environment variables
# Copy this file to .env and fill in the values.
# .env is gitignored. Never commit API keys.

# Ollama (local runtime — required for all labs)
OLLAMA_URL=http://localhost:11434
MODEL=mistral

# Agent loop ceiling (optional — default: 10)
MAX_ITERATIONS=10

# Fallback: OpenAI-compatible API (optional — use if Ollama tool calls are unreliable)
# Set MODEL=gpt-4o-mini when using this fallback.
OPENAI_API_KEY=
