# frameworks-tools module — environment variables
# Copy to .env and fill in values before running labs

# LLM provider: "ollama" (default, local) or "openai"
LLM_PROVIDER=ollama

# Ollama configuration (used when LLM_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
MODEL=mistral

# OpenAI configuration (used when LLM_PROVIDER=openai)
# Required for lab-autogen and lab-semantic-kernel
OPENAI_API_KEY=

# OpenAI model (used when LLM_PROVIDER=openai)
OPENAI_MODEL=gpt-4o-mini

# ChromaDB configuration (used by lab-llamaindex and lab-integration)
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Force LlamaIndex to rebuild the index from scratch (set to "true" to reset)
RESET_INDEX=false
