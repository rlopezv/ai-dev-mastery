# Memory Context — environment variables
# Copy this file to .env and fill in the values.
# .env is gitignored. Never commit API keys.

# Ollama (local runtime — required for all labs)
OLLAMA_URL=http://localhost:11434
MODEL=mistral
EMBED_MODEL=nomic-embed-text

# Context window size in tokens (default matches Mistral 7B)
CONTEXT_WINDOW=8192
