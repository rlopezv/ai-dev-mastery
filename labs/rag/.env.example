# Ollama base URL (no trailing slash)
OLLAMA_BASE_URL=http://localhost:11434

# Embedding model served by Ollama
# nomic-embed-text produces 768-dimensional vectors (fast, good quality)
# mxbai-embed-large produces 1024-dimensional vectors (slower, higher quality)
EMBED_MODEL=nomic-embed-text

# Generation model served by Ollama
GENERATION_MODEL=llama3.2

# Judge model for LLM-as-judge evaluation in lab-rag-evaluation
# Use a larger model here for more reliable judgements
JUDGE_MODEL=llama3.2

# ChromaDB persistent storage directory (relative to labs/rag/)
# Delete this directory to rebuild the index from scratch
CHROMA_PERSIST_DIR=./chroma_db

# Context window and generation parameters
CONTEXT_WINDOW=8192
MAX_TOKENS=512

# Generation temperature — set to 0.0 for reproducible outputs during debugging
TEMPERATURE=0.1
