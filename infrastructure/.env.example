# ─────────────────────────────────────────────
# PROFILE
# light → Ollama + Open WebUI
# full  → Ollama + Open WebUI + ChromaDB
# ─────────────────────────────────────────────
COMPOSE_PROFILES=light

# ─────────────────────────────────────────────
# MODEL
# Cambia este valor para usar un modelo diferente.
# El modelo se descargará automáticamente al abrir el devcontainer.
#
# Modelos recomendados:
#   tinyllama   → CPU, RAM limitada (<4GB)
#   llama3.2    → CPU con 8GB+ RAM o NVIDIA GPU (recomendado, usado en los labs)
#   llama3.2:1b → CPU, RAM limitada (<4GB), menor calidad
#   llama3      → NVIDIA GPU con 8GB+ VRAM
#   llama3:70b  → NVIDIA GPU con 24GB+ VRAM
# ─────────────────────────────────────────────
OLLAMA_MODEL=llama3.2

# ─────────────────────────────────────────────
# OLLAMA — configuración de rendimiento
#
# CPU only (sin GPU):
#   OLLAMA_MEMORY_LIMIT=4g
#   OLLAMA_NUM_PARALLEL=1
#   OLLAMA_CONTEXT_LENGTH=2048
#
# NVIDIA GPU (4-8GB VRAM, ej: RTX 3060):
#   OLLAMA_MEMORY_LIMIT=8g
#   OLLAMA_NUM_PARALLEL=1
#   OLLAMA_CONTEXT_LENGTH=4096
#
# NVIDIA GPU (8GB+ VRAM, ej: RTX 3060 Ti / 4070):
#   OLLAMA_MEMORY_LIMIT=12g
#   OLLAMA_NUM_PARALLEL=2
#   OLLAMA_CONTEXT_LENGTH=8192
# ─────────────────────────────────────────────
OLLAMA_PORT=11434
OLLAMA_KEEP_ALIVE=24h
OLLAMA_MEMORY_LIMIT=8g
OLLAMA_NUM_PARALLEL=1
OLLAMA_CONTEXT_LENGTH=4096

# ─────────────────────────────────────────────
# OPEN WEBUI
# ─────────────────────────────────────────────
WEBUI_PORT=3000
WEBUI_AUTH=false

# ─────────────────────────────────────────────
# CHROMADB (profile: full)
# ─────────────────────────────────────────────
CHROMA_PORT=8000
CHROMA_AUTH=none

# ─────────────────────────────────────────────
# EMBEDDING MODEL (usado en labs)
# ─────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
