# ─────────────────────────────────────────────
# PROFILE
# light → Ollama + Open WebUI
# full  → Ollama + Open WebUI + ChromaDB
# ─────────────────────────────────────────────
COMPOSE_PROFILES=light

# ─────────────────────────────────────────────
# OLLAMA
# ─────────────────────────────────────────────
OLLAMA_PORT=11434
OLLAMA_MODEL=mistral
OLLAMA_KEEP_ALIVE=24h
# Adjust based on available RAM (min 4g for mistral, 8g recommended)
OLLAMA_MEMORY_LIMIT=4g

# ─────────────────────────────────────────────
# OPEN WEBUI
# ─────────────────────────────────────────────
WEBUI_PORT=3000
WEBUI_AUTH=false

# ─────────────────────────────────────────────
# CHROMADB (profile: full)
# ─────────────────────────────────────────────
CHROMA_PORT=8000
CHROMA_AUTH=none

# ─────────────────────────────────────────────
# EMBEDDING MODEL (used in labs)
# ─────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
